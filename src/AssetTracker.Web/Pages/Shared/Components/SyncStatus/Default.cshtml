@model AssetTracker.Core.Directory.DirectorySyncStatus
<div class="alert alert--warning" role="status" id="sync-status-warning">
    @Ui.Icon("warning", 18, 2)
    <div class="alert-body">
        @if (Model.IsStale)
        {
            <span><strong>People data may be stale.</strong>@(Model.LastSuccessAt is { } t ? $" Last successful directory sync: {t:yyyy-MM-dd HH:mm} UTC." : " No directory sync has succeeded yet.")
                Recently disabled accounts may still appear active; lending is not blocked.</span>
        }
        @if (Model.LastRunUnsuccessful)
        {
            <span>Last directory sync @Model.LastRunStatus?.ToString().ToLowerInvariant()@(Model.LastRunError is null ? "." : $": {Model.LastRunError}") The previous snapshot is still in use.</span>
        }
    </div>
    <a asp-page="/Admin/Sync">View sync history</a>
</div>
