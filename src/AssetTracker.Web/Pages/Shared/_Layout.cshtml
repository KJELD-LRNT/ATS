@inject ICurrentUser CurrentUser
@{
    var demoMode = Context.RequestServices.GetService(typeof(AssetTracker.Infrastructure.Demo.DemoOptions)) is not null;

    // One sidebar link: the active page gets aria-current="page" (computed from the current page path, no JS).
    void NavLink(string page, string label, string icon, params string[] current)
    {
        var isCurrent = Ui.IsCurrent(ViewContext, current.Length == 0 ? [page] : current);
        <li><a class="nav-link" href="@Url.Page(page)" aria-current="@(isCurrent ? "page" : null)">@Ui.Icon(icon)<span class="nav-label">@label</span></a></li>
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Asset Tracker</title>
    <link rel="preload" href="~/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/inter-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    @* Not deferred: applies the saved light/dark theme before the first paint (no flash of the wrong colours). *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
@* Local demo mode only (renders nothing otherwise). *@
@await Component.InvokeAsync("DemoBanner")
@if (AssetTracker.Web.Security.SuperAdminPrincipal.Is(User))
{
    @* On every page while the super admin is signed in (never for Windows users). *@
    <div class="superadmin-banner" role="note" id="superadmin-banner">
        <strong>Signed in as the super admin (not an AD account).</strong>
        <a asp-page="/Local/SuperAdminAccount">Account and password</a>
        <form method="post" asp-page="/Local/SuperAdminSignOut" class="superadmin-banner-form">
            <button type="submit" class="btn--sm" id="superadmin-signout">Sign out</button>
        </form>
    </div>
}
<div class="app">
    <nav class="sidebar" aria-label="Main">
        <a class="brand" href="@Url.Page("/Index")">
            <span class="brand-mark">@Ui.Icon("tag", 18, 2)</span>
            <span class="brand-text"><span class="brand-name">Asset Tracker</span><span class="brand-sub">Internal IT</span></span>
        </a>
        @* Narrow screens only (and only with JavaScript): the menu folds away behind this button so the page content is not pushed down. *@
        <button type="button" class="menu-toggle" aria-controls="sidebar-menu" aria-expanded="true" data-menu-toggle hidden>Menu</button>
        <div class="sidebar-menu" id="sidebar-menu">

        <ul class="nav-group">
            @{ NavLink("/Index", "Overview", "overview"); }
            @if (CurrentUser.IsIt || CurrentUser.IsManager)
            {
                NavLink("/Assets/Index", "Assets", "assets", "/Assets/");
                NavLink("/Pools/Index", "Pools", "pools", "/Pools/");
                NavLink("/Loans/Index", "Loans", "loans", "/Loans/");
                NavLink("/Reports/Index", "Reports", "reports", "/Reports/");
            }
        </ul>

        @if (CurrentUser.IsIt || CurrentUser.IsFacility || CurrentUser.IsManager)
        {
            <ul class="nav-group" aria-labelledby="nav-workplace">
                <li class="nav-heading" id="nav-workplace">Workplace</li>
                @{ NavLink("/Workplace/Index", "Floor plans", "map", "/Workplace/"); }
            </ul>
        }

        @if (CurrentUser.IsIt)
        {
            <ul class="nav-group" aria-labelledby="nav-it">
                <li class="nav-heading" id="nav-it">IT</li>
                @{
                    NavLink("/Ops/Mail", "Mail queue", "mail");
                    NavLink("/Ops/Index", "Ops", "ops");
                    NavLink("/Audit/Index", "Audit log", "audit", "/Audit/");
                    if (!CurrentUser.IsAdmin)
                    {
                        NavLink("/Admin/Sync", "Directory sync", "sync");
                    }
                }
            </ul>
        }

        @if (CurrentUser.IsAdmin)
        {
            <ul class="nav-group" aria-labelledby="nav-admin">
                <li class="nav-heading" id="nav-admin">Admin</li>
                @{
                    NavLink("/Admin/Sites", "Sites", "sites");
                    NavLink("/Admin/Types", "Asset types", "types", "/Admin/Types", "/Admin/TypeEdit");
                    NavLink("/Admin/Vendors", "Vendors", "vendors");
                    NavLink("/Admin/Models", "Models", "models");
                    NavLink("/Admin/Grants", "Grants", "grants");
                    NavLink("/Admin/SystemRoles", "System roles", "roles");
                    NavLink("/Admin/OverviewTiles", "Overview tiles", "overview");
                    NavLink("/Admin/Settings", "Settings", "settings");
                    NavLink("/Admin/Sync", "Directory sync", "sync");
                    NavLink("/Admin/Privacy", "Privacy", "privacy");
                }
            </ul>
        }

        @if (demoMode)
        {
            <ul class="nav-group" aria-labelledby="nav-demo">
                <li class="nav-heading" id="nav-demo">Demo</li>
                @{
                    NavLink("/Demo/Index", "Demo controls", "demo");
                    NavLink("/Demo/Mailbox", "Demo mailbox", "inbox");
                }
            </ul>
        }

        <button type="button" class="rail-toggle" data-rail-toggle aria-pressed="false" hidden>@Ui.Icon("sidebar")<span class="rail-toggle-label">Collapse menu</span></button>
        <div class="user-card">
            <span class="avatar" aria-hidden="true">@Ui.Initials(CurrentUser.Name)</span>
            <span class="user-text">
                <span class="user-name">@CurrentUser.Name</span>
                <span class="user-roles">@Ui.RolesLabel(CurrentUser.Roles)</span>
            </span>
        </div>
        </div>
    </nav>

    <div class="main-col">
        <header class="topbar">
            <div class="topbar-title">Asset Tracker <span aria-hidden="true">/</span> <strong>@ViewData["Title"]</strong></div>
            @if (CurrentUser.IsIt)
            {
                @* The same lookup as the overview's "Find" box: scan or type a tag and press Enter to jump straight to its
                   return (checked out) or its page; people open their loans. Ctrl+K or / focuses it from anywhere. *@
                <form method="get" action="@Url.Page("/Assets/Index")" role="search" class="topbar-search" data-find-lookup data-global-search
                      data-prefix="top-find-option-" data-url="@Url.Page("/Index", "Find")" data-site=""
                      data-asset-url="@Url.Page("/Assets/Details", new { id = 123456789 })"
                      data-pool-url="@Url.Page("/Pools/Details", new { id = 123456789 })"
                      data-return-url="@Url.Page("/Loans/Return", new { id = 123456789 })"
                      data-checkout-asset-url="@Url.Page("/Loans/Checkout", new { assetId = 123456789 })"
                      data-checkout-pool-url="@Url.Page("/Loans/Checkout", new { poolId = 123456789 })"
                      data-person-url="@Url.Page("/Loans/Index", new { q = "__Q__" })">
                    <div class="combo">
                        <label for="top-q" class="visually-hidden">Find an item or a person</label>
                        <div class="searchbox">
                            @Ui.Icon("search", 16, 2)
                            <input id="top-q" name="q" type="search" placeholder="Scan a tag, find an item or a person" autocomplete="off"
                                   role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="top-find-list" aria-keyshortcuts="Control+K /" />
                            <kbd class="kbd" aria-hidden="true">Ctrl K</kbd>
                        </div>
                        <ul id="top-find-list" class="combo-list" role="listbox" aria-label="Matching items and people" hidden></ul>
                    </div>
                </form>
            }
            else if (CurrentUser.IsManager)
            {
                <form method="get" action="@Url.Page("/Assets/Index")" role="search" class="topbar-search" data-global-search>
                    <label for="top-q" class="visually-hidden">Search assets</label>
                    <div class="searchbox">
                        @Ui.Icon("search", 16, 2)
                        <input id="top-q" name="q" type="search" placeholder="Search tag, model, serial…" aria-keyshortcuts="Control+K /" />
                        <kbd class="kbd" aria-hidden="true">Ctrl K</kbd>
                    </div>
                </form>
            }
            <div class="topbar-tools">
                @* Light / follow the system / dark. Without JavaScript the buttons stay hidden and the light theme applies. *@
                <div class="theme-switch" role="group" aria-label="Colour theme" data-theme-switch hidden>
                    <button type="button" data-theme-set="light" aria-pressed="false" title="Light theme">@Ui.Icon("sun", 16)<span class="visually-hidden">Light theme</span></button>
                    <button type="button" data-theme-set="system" aria-pressed="false" title="Follow the system setting">@Ui.Icon("monitor", 16)<span class="visually-hidden">System theme</span></button>
                    <button type="button" data-theme-set="dark" aria-pressed="false" title="Dark theme">@Ui.Icon("moon", 16)<span class="visually-hidden">Dark theme</span></button>
                </div>
            </div>
        </header>
        <main class="main" id="main" tabindex="-1">
            @await Component.InvokeAsync("SyncStatus")
            @RenderBody()
        </main>
    </div>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
