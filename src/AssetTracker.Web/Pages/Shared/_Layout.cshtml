@inject ICurrentUser CurrentUser
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asset Tracker</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="topnav">
        <a class="brand" asp-page="/Index">Asset Tracker</a>
        @* Feature work packages add nav links here, gated on role. *@
        @if (CurrentUser.IsIt)
        {
            <a asp-page="/Audit/Index">Audit</a>
        }
        @if (CurrentUser.IsAdmin)
        {
            <a asp-page="/Admin/Sites">Sites</a>
            <a asp-page="/Admin/Grants">Grants</a>
            <a asp-page="/Admin/Settings">Settings</a>
            <a asp-page="/Admin/Sync">Directory sync</a>
        }
        <span class="user">@CurrentUser.Name (@CurrentUser.Roles)</span>
    </nav>
</header>
<main>
    @await Component.InvokeAsync("SyncStatus")
    @RenderBody()
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
