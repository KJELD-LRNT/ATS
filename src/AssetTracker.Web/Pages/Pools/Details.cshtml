@page "{id:int}"
@model AssetTracker.Web.Pages.Pools.DetailsModel
@{
    var p = Model.Pool;
    ViewData["Title"] = $"{p.Sku} at {p.Site?.Key}";
    var m = Ui.Stock(p.Available, p.OnHand, p.MinimumStock);
}
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-page="Index">Pools</a><span aria-hidden="true">/</span><span aria-current="page" class="mono">@p.Sku</span></nav>
@if (Model.Message is not null)
{
    <div class="alert alert--success" role="status">@Ui.Icon("check", 18, 2.4)<div class="alert-body">@Model.Message</div></div>
}
<header class="page-header page-header--top">
    <div class="page-heading">
        <div class="title-row">
            <h1 class="title-mono">@p.Sku</h1>
            @if (p.Available == 0) { @Ui.Pill("unavailable", "None available") }
            @if (p.IsBelowMinimum) { @Ui.Pill("due-today", $"Below minimum {p.MinimumStock}") }
        </div>
        <p class="title-meta">@p.Type pool at <strong>@p.Site?.Key – @p.Site?.Name</strong> · @p.Description</p>
    </div>
    @if (Model.CanEdit)
    {
        <div class="page-actions">
            <a class="btn" asp-page="Adjust" asp-route-id="@p.Id">Receipt / loss / count / transfer</a>
            @if (p.Available > 0)
            {
                <a class="btn btn--primary" asp-page="/Loans/Checkout" asp-route-poolId="@p.Id">Check out</a>
            }
        </div>
    }
</header>

<section class="kpis balances" aria-label="Balances">
    <div class="kpi kpi--accent">
        <span class="kpi-label">Available</span>
        <span class="kpi-value">@p.Available</span>
        <meter class="meter" min="0" max="@m.Max" low="@m.Low" high="@m.High" optimum="@m.Max" value="@p.Available"
               aria-label="@p.Available of @p.OnHand on hand available">@p.Available of @p.OnHand</meter>
    </div>
    <div class="kpi">
        <span class="kpi-label">Outstanding</span>
        <span class="kpi-value">@p.Outstanding</span>
        <span class="kpi-sub">on loan right now</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">On hand</span>
        <span class="kpi-value">@p.OnHand</span>
        <span class="kpi-sub">available + outstanding</span>
    </div>
    <div class="kpi @(p.IsBelowMinimum ? "kpi--due" : "")">
        <span class="kpi-label">Minimum stock</span>
        <span class="kpi-value">@(p.MinimumStock?.ToString() ?? "–")</span>
        @if (Model.CanEdit)
        {
            <form method="post" asp-page-handler="Minimum" asp-route-id="@p.Id" class="inline-form minimum-form">
                <label for="minimum" class="visually-hidden">Minimum stock level</label>
                <input id="minimum" name="minimum" type="number" min="0" max="@PoolService.MinimumStockMax" value="@p.MinimumStock" placeholder="none" class="qty" />
                <button type="submit" class="btn btn--sm">Set</button>
            </form>
            <span class="kpi-sub">Flagged on the overview below this; empty = none.</span>
        }
        else
        {
            <span class="kpi-sub">@(p.MinimumStock is null ? "no minimum set" : "flagged when available drops below this")</span>
        }
    </div>
</section>
<div asp-validation-summary="All" class="alert alert--error"></div>

@if (Model.Places.Count > 0)
{
    <section class="card card--flush" aria-labelledby="places-h">
        <div class="card-header"><h2 id="places-h">On the floor plans</h2></div>
        <div class="table-wrap">
            <table>
                <thead><tr><th scope="col">Workspot</th><th scope="col">Floor</th><th scope="col" class="num">Units</th></tr></thead>
                <tbody>
                @foreach (var pl in Model.Places)
                {
                    <tr>
                        <td><a asp-page="/Workplace/Floor" asp-route-id="@pl.FloorId" asp-route-focus="ws:@pl.WorkspotId">@pl.Label</a>@(pl.RoomName is null ? "" : $" ({pl.RoomName})")</td>
                        <td>@pl.SiteKey · @pl.FloorName</td>
                        <td class="num">@pl.Quantity</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="card card--flush" aria-labelledby="open-h">
    <div class="card-header"><h2 id="open-h">Open loans</h2></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Loan</th><th scope="col">Holder</th><th scope="col" class="num">Quantity</th><th scope="col" class="num">Outstanding</th><th scope="col">Due</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
            @foreach (var l in Model.OpenLoans)
            {
                <tr>
                    <td><a class="mono" asp-page="/Loans/Details" asp-route-id="@l.Id">#@l.Id</a></td>
                    <td>@(l.Holder?.DisplayName ?? l.HolderNameSnapshot)</td>
                    <td class="num">@l.Quantity</td>
                    <td class="num"><strong>@l.OutstandingQuantity</strong></td>
                    <td class="nowrap">@l.DueDate</td>
                    <td class="actions-cell">@if (Model.CanEdit) { <a class="btn btn--sm" asp-page="/Loans/Return" asp-route-id="@l.Id">Return</a> }</td>
                </tr>
            }
            @if (Model.OpenLoans.Count == 0)
            {
                <tr><td colspan="6" class="empty">No open loans.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="card card--flush" aria-labelledby="events-h">
    <div class="card-header">
        <h2 id="events-h">Stock events</h2>
        <span class="card-note">Every receipt, loss, count, transfer, checkout and return. Times in UTC.</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
            <tr><th scope="col">When (UTC)</th><th scope="col">Event</th><th scope="col" class="num">Change</th><th scope="col" class="num">Available after</th><th scope="col" class="num">Outstanding after</th><th scope="col">Reason</th><th scope="col">By</th></tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Events.Items)
            {
                <tr>
                    <td class="nowrap">@e.OccurredAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@InventoryUi.Describe(e.Type)@(e.CounterpartEventId is { } c ? $" (linked #{c})" : "")</td>
                    <td class="num mono">@e.QuantityDelta.ToString("+0;-0;0")</td>
                    <td class="num">@e.AvailableAfter</td>
                    <td class="num">@e.OutstandingAfter</td>
                    <td>@e.Reason</td>
                    <td>@e.Actor</td>
                </tr>
            }
            @if (Model.Events.TotalCount == 0)
            {
                <tr><td colspan="7" class="empty">No stock events yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</section>
