@page
@model AssetTracker.Web.Pages.Pools.IndexModel
@{
    ViewData["Title"] = "Pools";
}
<h1>Quantity pools</h1>
@if (Model.CanEdit)
{
    <p><a asp-page="Create">New pool</a></p>
}
<form method="get" class="filters">
    <label>Search<br /><input name="q" value="@Model.Q" placeholder="SKU or description" size="30" /></label>
    <label>Site<br />
        <select name="siteId" asp-for="SiteId" asp-items="Model.Sites"><option value="">All</option></select>
    </label>
    <label>Type<br />
        <select name="type" asp-for="Type" asp-items="InventoryUi.EnumOptions(AssetTypes.PoolEligible)"><option value="">All</option></select>
    </label>
    <button type="submit">Search</button>
</form>
<table>
    <thead>
    <tr><th>SKU</th><th>Type</th><th>Description</th><th>Site</th><th class="num">Available</th><th class="num">Outstanding</th><th class="num">On hand</th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Results.Items)
    {
        <tr>
            <td><a asp-page="Details" asp-route-id="@p.Id">@p.Sku</a></td>
            <td>@p.Type</td>
            <td>@p.Description</td>
            <td>@p.Site?.Key</td>
            <td class="num"><strong>@p.Available</strong></td>
            <td class="num">@p.Outstanding</td>
            <td class="num">@p.OnHand</td>
        </tr>
    }
    @if (Model.Results.TotalCount == 0)
    {
        <tr><td colspan="7" class="muted">No pools match.</td></tr>
    }
    </tbody>
</table>
<partial name="_Pager" model="Model.Pager" />
