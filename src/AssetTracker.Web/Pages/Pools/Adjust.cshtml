@page "{id:int}"
@model AssetTracker.Web.Pages.Pools.AdjustModel
@{
    var p = Model.Pool;
    ViewData["Title"] = $"Adjust {p.Sku}";
}
<nav class="breadcrumb" aria-label="Breadcrumb">
    <a asp-page="Index">Pools</a><span aria-hidden="true">/</span>
    <a class="mono" asp-page="Details" asp-route-id="@p.Id">@p.Sku</a><span aria-hidden="true">/</span>
    <span aria-current="page">Adjust</span>
</nav>
<header class="page-header">
    <div class="page-heading">
        <h1>Adjust <span class="title-mono">@p.Sku</span> <span class="title-meta">at @p.Site?.Key</span></h1>
        <p class="page-subtitle">Every adjustment needs a reason and is recorded as a stock event. Outstanding units change only through checkout and return.</p>
    </div>
</header>
<section class="kpis balances" aria-label="Balances">
    <div class="kpi kpi--accent"><span class="kpi-label">Available</span><span class="kpi-value">@p.Available</span></div>
    <div class="kpi"><span class="kpi-label">Outstanding</span><span class="kpi-value">@p.Outstanding</span></div>
    <div class="kpi"><span class="kpi-label">On hand</span><span class="kpi-value">@p.OnHand</span></div>
</section>
<div asp-validation-summary="All" class="alert alert--error"></div>

<div class="action-grid">
    <form method="post" asp-page-handler="Receipt" asp-route-id="@p.Id" class="action-card">
        <h2>Receipt</h2>
        <span class="hint">Adds to available.</span>
        <div class="field">
            <label for="rc-qty">Quantity</label>
            <input id="rc-qty" name="quantity" type="number" min="1" required placeholder="Quantity" class="qty" />
        </div>
        <div class="field">
            <label for="rc-reason">Reason</label>
            <input id="rc-reason" name="reason" required maxlength="2000" placeholder="Reason, e.g. PO number" />
        </div>
        <button type="submit" class="btn--primary">Record receipt</button>
    </form>
    <form method="post" asp-page-handler="Loss" asp-route-id="@p.Id" class="action-card">
        <h2>Loss</h2>
        <span class="hint">Removes from available.</span>
        <div class="field">
            <label for="ls-qty">Quantity</label>
            <input id="ls-qty" name="quantity" type="number" min="1" max="@p.Available" required placeholder="Quantity" class="qty" />
        </div>
        <div class="field">
            <label for="ls-reason">Reason</label>
            <input id="ls-reason" name="reason" required maxlength="2000" placeholder="Reason" />
        </div>
        <button type="submit">Record loss</button>
    </form>
    <form method="post" asp-page-handler="Count" asp-route-id="@p.Id" class="action-card">
        <h2>Count adjustment</h2>
        <span class="hint">Set available to the counted number on the shelf.</span>
        <div class="field">
            <label for="ct-qty">Counted available</label>
            <input id="ct-qty" name="counted" type="number" min="0" required placeholder="Counted available" class="qty" />
        </div>
        <div class="field">
            <label for="ct-reason">Reason</label>
            <input id="ct-reason" name="reason" required maxlength="2000" placeholder="Reason" />
        </div>
        <button type="submit">Set count</button>
    </form>
    <form method="post" asp-page-handler="Transfer" asp-route-id="@p.Id" class="action-card">
        <h2>Transfer</h2>
        <span class="hint">Move available units to another site.</span>
        @if (Model.TransferTargets.Count == 0)
        {
            <p class="secondary">No pool with this SKU exists at another site. Create one first.</p>
        }
        else
        {
            <div class="field">
                <label for="tf-pool">To pool</label>
                <select id="tf-pool" name="toPoolId" asp-items="Model.TransferTargets"></select>
            </div>
            <div class="field">
                <label for="tf-qty">Quantity</label>
                <input id="tf-qty" name="quantity" type="number" min="1" max="@p.Available" required placeholder="Quantity" class="qty" />
            </div>
            <div class="field">
                <label for="tf-reason">Reason</label>
                <input id="tf-reason" name="reason" required maxlength="2000" placeholder="Reason" />
            </div>
            <button type="submit">Transfer</button>
        }
    </form>
</div>
<p class="back-link"><a asp-page="Details" asp-route-id="@p.Id">Back to pool</a></p>
