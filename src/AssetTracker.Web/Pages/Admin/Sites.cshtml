@page
@model AssetTracker.Web.Pages.Admin.SitesModel
@{
    ViewData["Title"] = "Sites";
}
<header class="page-header">
    <div class="page-heading">
        <h1>Sites</h1>
        <div class="prose">
            <p>Each site's <em>AD site value</em> maps the directory site attribute to the site. People whose value matches no site are synced without a site and reported in the sync log.</p>
            <p>Each site's <em>timezone</em> decides its calendar: due dates, when a loan becomes overdue and when its daily reminders are sent. Leave it empty to use the default timezone (<strong>@Model.DefaultTimeZoneLabel</strong>).</p>
        </div>
    </div>
</header>
<datalist id="timezones">
    @foreach (var id in SitesModel.TimeZoneIds)
    {
        <option value="@id"></option>
    }
</datalist>

@if (Model.Message is not null)
{
    <div class="alert alert--success" role="status">@Ui.Icon("check", 18, 2.4)<div class="alert-body">@Model.Message</div></div>
}

<section class="card card--flush" aria-label="Sites">
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Key</th><th scope="col">Name</th><th scope="col">AD site value</th><th scope="col">Timezone</th><th scope="col">Active</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
            @foreach (var s in Model.Sites)
            {
                <tr class="@(Model.Editing?.Id == s.Id ? "selected" : "")">
                    <td class="mono">@s.Key</td>
                    <td>@s.Name</td>
                    <td>@(s.DirectoryValue ?? "(unmapped)")</td>
                    <td>@(s.TimeZoneId ?? "(default)")</td>
                    <td>@(s.IsActive ? Ui.Pill("available", "Yes") : Ui.Pill("unavailable", "No"))</td>
                    <td class="actions-cell"><a class="btn btn--sm" asp-page="/Admin/Sites" asp-route-editId="@s.Id">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

@if (Model.Editing is { } editing)
{
    <form method="post" asp-page-handler="Update" asp-route-id="@editing.Id" class="card form-card" aria-labelledby="site-form-h">
        <h2 id="site-form-h">Edit site <span class="mono">@editing.Key</span></h2>
        <div asp-validation-summary="All" class="alert alert--error"></div>
        <p class="secondary">Key: <strong class="mono">@editing.Key</strong> (cannot be changed)</p>
        <div class="fields">
            <div class="field"><label asp-for="Input.Name"></label> <input asp-for="Input.Name" /></div>
            <div class="field"><label asp-for="Input.DirectoryValue"></label> <input asp-for="Input.DirectoryValue" /></div>
            <div class="field span-all">
                <label asp-for="Input.TimeZoneId"></label> <input asp-for="Input.TimeZoneId" list="timezones" placeholder="default" />
                <small class="hint">IANA (e.g. Europe/Amsterdam) or Windows id; empty = default.</small>
            </div>
            <div class="field span-all"><label class="check"><input asp-for="Input.IsActive" /> Active</label></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn--primary">Save</button> <a class="text-link" asp-page="/Admin/Sites">Cancel</a></div>
    </form>
}
else
{
    <form method="post" asp-page-handler="Create" class="card form-card" aria-labelledby="site-form-h">
        <h2 id="site-form-h">New site</h2>
        <div asp-validation-summary="All" class="alert alert--error"></div>
        <div class="fields">
            <div class="field">
                <label asp-for="Input.Key"></label> <input asp-for="Input.Key" class="mono" />
                <small class="hint">Stable short key, e.g. HQ; cannot be changed later.</small>
            </div>
            <div class="field"><label asp-for="Input.Name"></label> <input asp-for="Input.Name" /></div>
            <div class="field"><label asp-for="Input.DirectoryValue"></label> <input asp-for="Input.DirectoryValue" /></div>
            <div class="field">
                <label asp-for="Input.TimeZoneId"></label> <input asp-for="Input.TimeZoneId" list="timezones" placeholder="default" />
                <small class="hint">IANA (e.g. Europe/Amsterdam) or Windows id; empty = default.</small>
            </div>
            <div class="field span-all"><label class="check"><input asp-for="Input.IsActive" /> Active</label></div>
        </div>
        <div class="form-actions"><button type="submit" class="btn--primary">Create</button></div>
    </form>
}
