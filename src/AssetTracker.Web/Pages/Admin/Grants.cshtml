@page
@model AssetTracker.Web.Pages.Admin.GrantsModel
@{
    ViewData["Title"] = "Manager site grants";
}
<header class="page-header">
    <div class="page-heading">
        <h1>Manager site grants</h1>
        <p class="page-subtitle">A grant gives a manager read access to one site's inventory. It only takes effect while the person is a member of the manager AD group.</p>
    </div>
</header>

@if (Model.Message is not null)
{
    <div class="alert alert--success" role="status">@Ui.Icon("check", 18, 2.4)<div class="alert-body">@Model.Message</div></div>
}
<div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

<section class="card card--flush" aria-labelledby="grants-h">
    <div class="card-header"><h2 id="grants-h">Current grants</h2></div>
    @if (Model.Grants.Count == 0)
    {
        <div class="empty-state"><strong>No grants.</strong><span>Managers see nothing until they are granted a site.</span></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th scope="col">Site</th><th scope="col">Person</th><th scope="col">Username</th><th scope="col">Granted</th><th scope="col">By</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var g in Model.Grants)
                {
                    <tr>
                        <td><span class="mono">@g.SiteKey</span> - @g.SiteName</td>
                        <td><span class="cell-row">@(g.PersonDisplayName ?? "(not in directory snapshot)")@if (g.PersonActive == false) { <span class="badge badge--muted">Inactive</span> }</span></td>
                        <td>@(g.PersonUsername ?? g.PrincipalName)</td>
                        <td class="nowrap">@g.GrantedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td>@g.GrantedBy</td>
                        <td class="actions-cell">
                            <form method="post" asp-page-handler="Remove" asp-route-grantId="@g.Id">
                                <button type="submit" class="btn--danger btn--sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card card--flush" aria-labelledby="add-h">
    <div class="card-header"><h2 id="add-h">Add a grant</h2></div>
    <div class="card-body">
        <form method="get" class="search-row" role="search">
            <div class="field field--grow">
                <label for="q">Find person (name or username)</label>
                <input id="q" name="q" value="@Model.Q" minlength="2" type="search" />
            </div>
            <button type="submit">Search</button>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Q))
    {
        @if (Model.People.Count == 0)
        {
            <div class="empty-state"><strong>No matching people.</strong></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead><tr><th scope="col">Name</th><th scope="col">Username</th><th scope="col">Job title</th><th scope="col">AD site</th><th scope="col">Grant site</th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.People)
                    {
                        <tr>
                            <td><span class="cell-row">@p.DisplayName@if (!p.IsActive) { <span class="badge badge--muted">Inactive</span> }</span></td>
                            <td>@p.Username</td>
                            <td>@p.JobTitle</td>
                            <td>@p.SiteKey</td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <form method="post" asp-page-handler="Add" asp-route-q="@Model.Q" class="inline-form">
                                        <input type="hidden" name="personId" value="@p.Id" />
                                        <label for="site-@p.Id" class="visually-hidden">Site for @p.DisplayName</label>
                                        <select id="site-@p.Id" name="siteId">
                                            @foreach (var s in Model.Sites)
                                            {
                                                <option value="@s.Id">@s.Key - @s.Name</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn--primary">Grant</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</section>
