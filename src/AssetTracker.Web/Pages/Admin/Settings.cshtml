@page
@model AssetTracker.Web.Pages.Admin.SettingsModel
@using AssetTracker.Core.Settings
@using AssetTracker.Web.Pages.Admin
@{
    ViewData["Title"] = "Settings";

    async Task Field(SettingView v)
    {
        var d = v.Definition;
        var id = SettingsModel.FieldId(d.Key);
        var value = Model.FieldValue(v);
        var fallback = v.FileValue ?? d.Default;
        var placeholder = fallback is null ? "not set" : (v.FileValue is not null ? "config file: " : "default: ") + fallback;
        Model.FieldErrors.TryGetValue(d.Key, out var error);
        var errorId = id + "-error";
        <tr>
            <td>
                <div class="setting-stack">
                    <label for="@id">@d.Label</label>
                    <code class="setting-key">@d.Key</code>
                </div>
            </td>
            <td>
                <div class="setting-stack">
                    @switch (d.Kind)
                    {
                        case SettingKind.Secret:
                            <input id="@id" name="@d.Key" type="password" autocomplete="new-password" aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : errorId)" />
                            <small class="hint">Currently: <strong>@(v.SecretSet ? "set" : "not set")</strong>@(v.Source == SettingSource.ConfigFile ? " (config file)" : "")</small>
                            <label class="check"><input type="checkbox" name="@SettingsModel.ClearPasswordField" value="true" /> Clear the stored password</label>
                            break;
                        case SettingKind.Boolean:
                        case SettingKind.Choice:
                            var choices = d.Kind == SettingKind.Boolean ? new[] { "true", "false" } : (d.Choices ?? []).ToArray();
                            <select id="@id" name="@d.Key" aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : errorId)">
                                <option value="" selected="@(value == "")">(no override: @(fallback ?? "not set"))</option>
                                @foreach (var c in choices)
                                {
                                    <option value="@c" selected="@(string.Equals(value, c, StringComparison.OrdinalIgnoreCase))">@c</option>
                                }
                            </select>
                            break;
                        case SettingKind.TimeZone:
                            <input id="@id" name="@d.Key" value="@value" list="tz-list" placeholder="@placeholder" aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : errorId)" />
                            break;
                        default:
                            <input id="@id" name="@d.Key" value="@value" placeholder="@placeholder" aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : errorId)" />
                            break;
                    }
                    @if (error is not null)
                    {
                        <span class="field-error error" id="@errorId">@error</span>
                    }
                    @if (!string.IsNullOrEmpty(d.Help))
                    {
                        <small class="hint">@d.Help</small>
                    }
                </div>
            </td>
            <td class="setting-value">
                @if (d.Kind == SettingKind.Secret)
                {
                    <span>@(v.SecretSet ? "set" : "not set")</span>
                }
                else
                {
                    <span>@(v.EffectiveValue ?? "—")</span>
                }
            </td>
            <td>
                <div class="setting-stack">
                    <span><span class="source source-@v.Source.ToString().ToLowerInvariant()">@SettingsModel.SourceLabel(v.Source)</span></span>
                    @if (v.UpdatedBy is not null)
                    {
                        <small class="hint">@v.UpdatedBy, @v.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") UTC</small>
                    }
                </div>
            </td>
        </tr>
    }
}
<header class="page-header">
    <div class="page-heading">
        <h1>Settings</h1>
        <p class="page-subtitle">
            Values saved here are stored in the database and override the configuration files; leave a field empty to remove
            the override (the config file value or the default applies again). Changes reach the web app immediately and the
            worker within <code>Settings:ReloadInterval</code> (30 seconds by default). Connection strings and the Data Protection
            key folder stay in <code>appsettings.Production.json</code>. Roles are given under <a asp-page="/Admin/SystemRoles">System roles</a>.
        </p>
    </div>
</header>
@if (Model.LegacyRoleSettingsPresent)
{
    <div class="alert alert--warning" id="legacy-roles-note" role="note">
        @Ui.Icon("warning", 18, 2)
        <div class="alert-body">@AssetTracker.Web.Security.LegacyRoleSettings.Notice</div>
    </div>
}
@if (HttpContext.RequestServices.GetService(typeof(AssetTracker.Infrastructure.Demo.DemoOptions)) is not null)
{
    <div class="alert alert--warning" id="demo-settings-note" role="note">
        @Ui.Icon("warning", 18, 2)
        <div class="alert-body">Local demo mode: the directory is the fictional demo directory and mail is
            written to the <a asp-page="/Demo/Mailbox">demo mailbox</a>, whatever the relay and Active Directory values below
            say. Saving, <em>Test directory query</em> and <em>Send test email</em> still work (the test email lands in the demo mailbox).</div>
    </div>
}

@if (Model.Message is not null)
{
    <div class="alert alert--success" role="status">@Ui.Icon("check", 18, 2.4)<div class="alert-body">@Model.Message</div></div>
}
@* Hand-written summary: the validation-summary tag helper emits an inline style, which the CSP blocks. *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert--error" role="alert">
        @Ui.Icon("error", 18, 2)
        <div class="alert-body">
            <ul>
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@e.ErrorMessage</li>
                }
            </ul>
        </div>
    </div>
}

<nav class="settings-toc" aria-label="Sections">
    @foreach (var (id, title) in SettingsModel.Sections)
    {
        <a href="#@id">@title</a>
    }
</nav>

@foreach (var (sec, title) in SettingsModel.Sections)
{
    <section id="@sec" class="settings-section card card--flush" aria-labelledby="@sec-h">
        <div class="card-header"><h2 id="@sec-h">@title</h2></div>
        <form method="post">
            <input type="hidden" name="section" value="@sec" />
            <div class="table-wrap">
                <table class="settings-table">
                    <thead><tr><th scope="col">Setting</th><th scope="col">Override</th><th scope="col">Effective value</th><th scope="col">Source</th></tr></thead>
                    <tbody>
                    @foreach (var v in Model.Overview.InSection(sec))
                    {
                        await Field(v);
                    }
                    @if (sec == SettingSections.Notifications)
                    {
                        Model.FieldErrors.TryGetValue(SettingCatalog.ItMailboxField, out var itError);
                        <tr>
                            <td><label for="s-ItMailbox">IT mailbox / distribution list</label></td>
                            <td>
                                <div class="setting-stack">
                                    <input id="s-ItMailbox" name="@SettingCatalog.ItMailboxField" type="email" value="@Model.ItMailboxValue" aria-invalid="@(itError is null ? null : "true")" />
                                    @if (itError is not null)
                                    {
                                        <span class="field-error error">@itError</span>
                                    }
                                    <small class="hint">Receives a copy of checkout, return, correction and overdue emails.</small>
                                </div>
                            </td>
                            <td class="setting-value">@(Model.Overview.ItMailbox ?? "—")</td>
                            <td><span class="source @(Model.Overview.ItMailbox is null ? "" : "source-database")">@(Model.Overview.ItMailbox is null ? "not set" : "database")</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="settings-form-footer"><button type="submit" class="btn--primary">Save @title.ToLowerInvariant()</button></div>
        </form>

        @if (sec == SettingSections.Directory)
        {
            <form method="post" asp-page-handler="TestDirectory" class="settings-test">
                <button type="submit">Test directory query</button>
                <small class="hint">Queries the directory with the <strong>saved</strong> settings and runs the sync's checks. Read-only: nothing is synced.</small>
            </form>
            @if (Model.Preview is { } outcome)
            {
                <div class="settings-result" id="directory-preview">
                    @if (outcome.Error is not null)
                    {
                        <p class="error">Directory query failed: @outcome.Error</p>
                    }
                    else if (outcome.Preview is { } p)
                    {
                        <p>
                            Fetched <strong>@p.Fetched</strong> entries: <strong>@p.Valid</strong> valid,
                            <strong>@p.Quarantined</strong> would be quarantined.
                            Of the valid entries, <strong>@p.MappedToSite</strong> map to a known site,
                            @p.UnmappedSite have an unmapped site value and @p.MissingSite have none; @p.Disabled are disabled.
                        </p>
                        @if (p.WouldReject is not null)
                        {
                            <p class="warning">A sync now would be rejected: @p.WouldReject</p>
                        }
                        else
                        {
                            <p class="notice">A sync now would pass the safety checks (would deactivate @p.WouldDeactivate of @p.CurrentActive active people).</p>
                        }
                        @if (p.Sample.Count > 0)
                        {
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th scope="col">Username</th><th scope="col">Display name</th><th scope="col">Site value</th><th scope="col">Site mapped</th><th scope="col">Enabled</th></tr></thead>
                                    <tbody>
                                    @foreach (var e in p.Sample)
                                    {
                                        <tr><td>@e.Username</td><td>@e.DisplayName</td><td>@(e.SiteValue ?? "—")</td><td>@(e.SiteMapped ? "yes" : "no")</td><td>@(e.Enabled ? "yes" : "no")</td></tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @if (p.Issues.Count > 0)
                        {
                            <details>
                                <summary>@p.Issues.Count issue(s)</summary>
                                <ul>
                                    @foreach (var i in p.Issues.Take(50))
                                    {
                                        <li><code>@i.Code</code> @i.Message @(i.Username ?? i.DirectoryId)</li>
                                    }
                                </ul>
                            </details>
                        }
                    }
                </div>
            }
        }

        @if (sec == SettingSections.Mail)
        {
            <form method="post" asp-page-handler="TestMail" class="settings-test">
                <label for="TestMailTo">Send a test email to</label>
                <input asp-for="TestMailTo" type="email" />
                <button type="submit">Send test email</button>
                <small class="hint">Sent directly through the relay with the <strong>saved</strong> settings (not via the outbox).</small>
            </form>
            @if (Model.MailTest is { } mt)
            {
                <div class="settings-result" id="mail-test">
                    @if (mt.Success)
                    {
                        <p class="notice">Test email to @mt.To was accepted by the relay.</p>
                    }
                    else
                    {
                        <p class="error">Test email to @mt.To failed: @mt.Error</p>
                    }
                </div>
            }
        }
    </section>
}

<datalist id="tz-list">
    @foreach (var tz in SettingsModel.TimeZoneIds)
    {
        <option value="@tz"></option>
    }
</datalist>
