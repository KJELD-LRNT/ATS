@page
@model AssetTracker.Web.Pages.Admin.SyncModel
@using AssetTracker.Web.Pages.Admin
@{
    ViewData["Title"] = "Directory sync";
}
<h1>Directory sync</h1>

@if (Model.Message is not null)
{
    <p class="notice">@Model.Message</p>
}
<div asp-validation-summary="ModelOnly" class="error"></div>

@if (Model.Status is { } st)
{
    <p>
        Last successful sync:
        <strong>@(st.LastSuccessAt is { } last ? last.ToString("yyyy-MM-dd HH:mm") + " UTC" : "never")</strong>
        @if (st.IsStale) { <span class="error">(stale)</span> }
    </p>
}

<form method="post" asp-page-handler="Run">
    <button type="submit">Run sync now</button>
    <small>Runs a full directory sync and waits for it to finish.</small>
</form>

<h2>History</h2>
<table>
    <thead>
    <tr><th>#</th><th>Started (UTC)</th><th>Finished</th><th>Status</th><th>By</th><th>Fetched</th><th>Mapped</th><th>Quarantined</th><th>Created</th><th>Updated</th><th>Deactivated</th></tr>
    </thead>
    <tbody>
    @foreach (var r in Model.Runs.Items)
    {
        var issues = SyncModel.Issues(r);
        <tr>
            <td>@r.Id</td>
            <td>@r.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
            <td>@r.FinishedAt?.ToString("HH:mm:ss")</td>
            <td class="@(r.Status is AssetTracker.Core.Domain.SyncRunStatus.Succeeded ? "" : "error")">@r.Status</td>
            <td>@r.TriggeredBy</td>
            <td>@r.Fetched</td>
            <td>@r.Mapped</td>
            <td>@r.Quarantined</td>
            <td>@r.Created</td>
            <td>@r.Updated</td>
            <td>@r.Deactivated</td>
        </tr>
        @if (r.Error is not null || issues.Count > 0)
        {
            <tr>
                <td></td>
                <td colspan="10">
                    @if (r.Error is not null) { <div class="error">@r.Error</div> }
                    @if (issues.Count > 0)
                    {
                        <details>
                            <summary>@issues.Count issue(s)</summary>
                            <ul>
                                @foreach (var i in issues)
                                {
                                    <li><code>@i.Code</code> @i.Message @(i.Username is null ? "" : $"[{i.Username}]") @(i.DirectoryId is null ? "" : $"({i.DirectoryId})")</li>
                                }
                            </ul>
                        </details>
                    }
                </td>
            </tr>
        }
    }
    </tbody>
</table>

<p>
    @if (Model.Runs.HasPrevious) { <a asp-page="/Admin/Sync" asp-route-p="@(Model.Runs.Page - 1)">Newer</a> }
    Page @Model.Runs.Page of @Model.Runs.PageCount
    @if (Model.Runs.HasNext) { <a asp-page="/Admin/Sync" asp-route-p="@(Model.Runs.Page + 1)">Older</a> }
</p>
