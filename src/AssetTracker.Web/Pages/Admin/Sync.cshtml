@page
@model AssetTracker.Web.Pages.Admin.SyncModel
@using AssetTracker.Web.Pages.Admin
@{
    ViewData["Title"] = "Directory sync";
}
<header class="page-header">
    <div class="page-heading">
        <h1>Directory sync</h1>
        @if (Model.Status is { } st)
        {
            <p class="page-subtitle cell-row">
                <span>Last successful sync:
                    <strong>@(st.LastSuccessAt is { } last ? last.ToString("yyyy-MM-dd HH:mm") + " UTC" : "never")</strong></span>
                @if (st.IsStale) { <span class="pill pill--overdue">Stale</span><span class="visually-hidden">(stale)</span> }
            </p>
        }
    </div>
    @if (Model.CanRun)
    {
        <form method="post" asp-page-handler="Run" class="page-actions">
            <small class="hint">Runs a full directory sync and waits for it to finish.</small>
            <button type="submit" class="btn--primary">@Ui.Icon("sync", 16, 2) Run sync now</button>
        </form>
    }
</header>

@if (Model.Message is not null)
{
    <div class="alert alert--success" role="status">@Ui.Icon("check", 18, 2.4)<div class="alert-body">@Model.Message</div></div>
}
<div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

@if (!Model.CanRun)
{
    <div class="alert alert--info" role="note">@Ui.Icon("error", 18, 2)<div class="alert-body">Read-only view. An application admin can run a sync manually. Failed or rejected runs are also mailed to the IT mailbox.</div></div>
}

<section class="card card--flush" aria-labelledby="hist-h">
    <div class="card-header"><h2 id="hist-h">History</h2></div>
    <div class="table-wrap">
        <table>
            <thead>
            <tr><th scope="col">#</th><th scope="col">Started (UTC)</th><th scope="col">Finished</th><th scope="col">Status</th><th scope="col">By</th><th scope="col" class="num">Fetched</th><th scope="col" class="num">Mapped</th><th scope="col" class="num">Quarantined</th><th scope="col" class="num">Created</th><th scope="col" class="num">Updated</th><th scope="col" class="num">Deactivated</th></tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Runs.Items)
            {
                var issues = SyncModel.Issues(r);
                <tr>
                    <td class="mono">@r.Id</td>
                    <td class="nowrap">@r.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td class="nowrap">@r.FinishedAt?.ToString("HH:mm:ss")</td>
                    <td>@Ui.Pill(r.Status)</td>
                    <td>@r.TriggeredBy</td>
                    <td class="num">@r.Fetched</td>
                    <td class="num">@r.Mapped</td>
                    <td class="num">@r.Quarantined</td>
                    <td class="num">@r.Created</td>
                    <td class="num">@r.Updated</td>
                    <td class="num">@r.Deactivated</td>
                </tr>
                @if (r.Error is not null || issues.Count > 0)
                {
                    <tr class="detail-row">
                        <td></td>
                        <td colspan="10">
                            <div class="stack stack--tight">
                                @if (r.Error is not null) { <div class="error">@r.Error</div> }
                                @if (issues.Count > 0)
                                {
                                    <details>
                                        <summary>@issues.Count issue(s)</summary>
                                        <ul>
                                            @foreach (var i in issues)
                                            {
                                                <li><code>@i.Code</code> @i.Message @(i.Username is null ? "" : $"[{i.Username}]") @(i.DirectoryId is null ? "" : $"({i.DirectoryId})")</li>
                                            }
                                        </ul>
                                    </details>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            @if (Model.Runs.Items.Count == 0)
            {
                <tr><td colspan="11" class="empty">No sync has run yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <nav class="pager" aria-label="Pages">
        <span>Page @Model.Runs.Page of @Model.Runs.PageCount</span>
        <span class="pager-links">
            @if (Model.Runs.HasPrevious) { <a class="btn btn--sm" asp-page="/Admin/Sync" asp-route-p="@(Model.Runs.Page - 1)">Newer</a> }
            @if (Model.Runs.HasNext) { <a class="btn btn--sm" asp-page="/Admin/Sync" asp-route-p="@(Model.Runs.Page + 1)">Older</a> }
        </span>
    </nav>
</section>
