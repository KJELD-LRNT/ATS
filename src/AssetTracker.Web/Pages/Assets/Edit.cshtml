@page "{id:int}"
@model AssetTracker.Web.Pages.Assets.EditModel
@{
    var a = Model.Asset;
    ViewData["Title"] = $"Edit {a.Tag}";
}
<h1>Edit @a.Tag <span class="muted">@a.Type at @a.Site?.Key — @a.State</span></h1>
<div asp-validation-summary="All" class="error"></div>

@if (a.State != AssetState.Retired)
{
    <form method="post">
        <div class="form-grid">
            <label asp-for="Input.Description">Description / model</label>
            <input asp-for="Input.Description" required maxlength="500" />
            <label asp-for="Input.Condition">Condition</label>
            <input asp-for="Input.Condition" maxlength="200" />
            <label asp-for="Input.SerialNumber">Serial number</label>
            <input asp-for="Input.SerialNumber" maxlength="128" />
            @if (a.Type is AssetType.Phone or AssetType.PhoneNumber)
            {
                <label asp-for="Input.PhoneNumber">Phone number</label>
                <input asp-for="Input.PhoneNumber" />
            }
            @if (a.Type == AssetType.Phone)
            {
                <label asp-for="Input.Imei">IMEI</label>
                <input asp-for="Input.Imei" />
            }
            <div class="full"><button type="submit">Save</button> <a asp-page="Details" asp-route-id="@a.Id">Cancel</a></div>
        </div>
    </form>

    <div class="actions">
        @if (a.State == AssetState.Available)
        {
            <form method="post" asp-page-handler="MarkUnavailable" asp-route-id="@a.Id">
                <strong>Mark unavailable</strong><br />
                <input name="reason" placeholder="Reason (e.g. repair)" />
                <button type="submit">Mark unavailable</button>
            </form>
        }
        @if (a.State == AssetState.Unavailable)
        {
            <form method="post" asp-page-handler="MarkAvailable" asp-route-id="@a.Id">
                <strong>Return to circulation</strong><br />
                <input name="reason" placeholder="Reason (optional)" />
                <button type="submit">Mark available</button>
            </form>
        }
        @if (a.State is AssetState.Available or AssetState.Unavailable)
        {
            <form method="post" asp-page-handler="Transfer" asp-route-id="@a.Id">
                <strong>Move to site</strong><br />
                <select name="toSiteId" asp-items="Model.Sites"></select>
                <input name="reason" placeholder="Reason (optional)" />
                <button type="submit">Move</button>
            </form>
            <form method="post" asp-page-handler="Retire" asp-route-id="@a.Id"
                  onsubmit="return confirm('Retire this asset? This cannot be undone.');">
                <strong>Retire</strong><br />
                <input name="reason" placeholder="Reason (optional)" />
                <button type="submit">Retire</button>
            </form>
        }
        @if (a.State == AssetState.CheckedOut)
        {
            <p class="muted">The asset is checked out: return it before changing its state or site.</p>
        }
    </div>
}
else
{
    <p class="muted">This asset is retired and can no longer be edited.</p>
}
