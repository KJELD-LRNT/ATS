@page
@model AssetTracker.Web.Pages.Loans.CheckoutModel
@{
    ViewData["Title"] = "Check out";
}
<h1>Check out</h1>
@if (Model.DirectoryStale)
{
    <p class="warning"><strong>The people directory snapshot is stale.</strong> Checkout is still allowed, but recently
        disabled accounts may still appear active. The stale state is recorded on the loan and in the audit log.</p>
}
<div asp-validation-summary="All" class="error"></div>

<h2>1. Item and person</h2>
<form method="get" class="filters">
    <label>Asset tag<br /><input name="tag" value="@(Model.Asset?.Tag ?? Model.Tag)" placeholder="Tagged asset" size="16" /></label>
    <span class="muted">or</span>
    <label>Pool<br />
        <select name="poolId" asp-items="Model.Pools"><option value="">–</option></select>
    </label>
    <label>Quantity (pool)<br /><input name="quantity" type="number" min="1" value="@Model.Quantity" class="qty" /></label>
    <label>Person<br /><input name="who" value="@Model.Who" placeholder="Name, username or email" size="28" /></label>
    <button type="submit">Find</button>
</form>
<p class="muted">Only active people with an email address can receive new loans.</p>

@if (Model.TargetError is not null)
{
    <p class="error">@Model.TargetError</p>
}
else if (Model.Asset is not null || Model.Pool is not null)
{
    <h2>2. Confirm</h2>
    <form method="post">
        <div class="form-grid">
            @if (Model.Asset is { } a)
            {
                <input type="hidden" name="Input.AssetId" value="@a.Id" />
                <span>Item</span><span><strong>@a.Tag</strong> – @a.Description (@a.Type) at @a.Site?.Key · quantity <strong>1</strong></span>
            }
            else if (Model.Pool is { } p)
            {
                <input type="hidden" name="Input.PoolId" value="@p.Id" />
                <span>Pool</span><span><strong>@p.Sku</strong> – @p.Description at @p.Site?.Key · <strong>@p.Available</strong> available</span>
                <label for="qty"><strong>Quantity</strong></label>
                <input id="qty" name="Input.Quantity" type="number" min="1" max="@p.Available" value="@Model.Quantity" required class="qty" />
            }
            <span>Person</span>
            <span>
                @if (Model.People.Count == 0)
                {
                    <span class="muted">Search for a person above.</span>
                }
                @foreach (var person in Model.People)
                {
                    <label><input type="radio" name="Input.HolderId" value="@person.Id" required checked="@(Model.Input.HolderId == person.Id)" />
                        @person.DisplayName <span class="muted">@person.Username · @person.Email @person.SiteKey</span></label><br />
                }
            </span>
            <label for="due">Due date (optional)</label>
            <input id="due" name="Input.DueDate" type="date" value="@Model.Input.DueDate?.ToString("yyyy-MM-dd")" />
            <label for="cond">Condition</label>
            <input id="cond" name="Input.Condition" maxlength="200" value="@Model.Input.Condition" />
            <label for="note">Note</label>
            <input id="note" name="Input.Note" maxlength="2000" value="@Model.Input.Note" />
            <div class="full"><button type="submit" disabled="@(Model.People.Count == 0)">Confirm checkout</button> <a asp-page="Index">Cancel</a></div>
        </div>
    </form>
}
