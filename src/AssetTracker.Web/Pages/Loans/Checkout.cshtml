@page
@model AssetTracker.Web.Pages.Loans.CheckoutModel
@{
    ViewData["Title"] = "Check out";
    var hasTarget = Model.TargetError is null && (Model.Asset is not null || Model.Pool is not null);
    // What the finder box shows: the chosen item's tag or SKU, else the text that was typed.
    var itemText = Model.Asset?.Tag ?? Model.Pool?.Sku ?? Model.Tag;
    var itemSiteKey = Model.Asset?.Site?.Key ?? Model.Pool?.Site?.Key;
    var staleText ="The people directory snapshot is stale. Checkout is still allowed, but recently disabled accounts may still appear active. The stale state is recorded on the loan and in the audit log.";
}
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-page="Index">Loans</a><span aria-hidden="true">/</span><span aria-current="page">Check out</span></nav>
<h1>Check out</h1>
@if (Model.DirectoryStale && !hasTarget)
{
    <div class="alert alert--warning" role="status">@Ui.Icon("warning", 18, 2)<div class="alert-body">@staleText</div></div>
}
<div asp-validation-summary="All" class="alert alert--error"></div>

<div class="columns">
    <div class="col-main">
        <form method="get" class="card" aria-labelledby="find-h">
            <h2 id="find-h" class="visually-hidden">Find item and person</h2>
            <fieldset>
                <legend><span class="step-number">1.</span> What is being lent?</legend>
                <div class="search-row">
                    <div class="field field--grow combo" data-item-lookup data-url="@Url.Page("Checkout", "Items")" data-min="@CheckoutModel.MinSearchLength">
                        <label for="f-tag">Item</label>
                        <input id="f-tag" name="tag" value="@itemText" type="search" placeholder="Tag, model, serial number, phone number or IMEI"
                               autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="item-list" aria-describedby="item-hint" />
                        @* Set by the finder when an item is picked (enabled only then, so without JavaScript just the text is searched). *@
                        <input type="hidden" name="assetId" value="@Model.Asset?.Id" data-item-asset disabled />
                        <input type="hidden" name="poolId" value="@Model.Pool?.Id" data-item-pool disabled />
                        <ul id="item-list" class="combo-list" role="listbox" aria-label="Matching items" hidden></ul>
                    </div>
                    <div class="field field--auto">
                        <label for="f-type">Type</label>
                        <select id="f-type" name="type" data-item-type>
                            <option value="">All types</option>
                            @foreach (var t in Model.Types)
                            {
                                <option value="@t.Value" selected="@(t.Value == Model.FilterType?.ToString())">@t.Text</option>
                            }
                        </select>
                    </div>
                    <div class="field field--auto">
                        <label for="f-site">Site</label>
                        <select id="f-site" name="site" data-item-site>
                            <option value="">All sites</option>
                            @foreach (var s in Model.Sites)
                            {
                                <option value="@s.Value" selected="@(s.Value == Model.FilterSite?.ToString())">@s.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <span class="hint" id="item-hint">Scan or type a tag and press Enter, or search by model, serial number, phone number or IMEI. Click the box with nothing typed to browse what is available; quantity items such as headsets are in the same list. Picking a person sets the site filter to theirs.</span>
            </fieldset>
            <fieldset>
                <legend><span class="step-number">2.</span> Who receives it?</legend>
                <div class="search-row">
                    <div class="field field--grow combo" data-people-lookup data-url="@Url.Page("Checkout", "People")" data-min="@CheckoutModel.MinSearchLength">
                        <label for="f-who">Person</label>
                        <input id="f-who" name="who" value="@Model.Who" type="search" placeholder="Start typing a name, username or email"
                               autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="who-list" aria-describedby="who-hint" />
                        <input type="hidden" name="holderId" value="@Model.HolderId" data-people-id />
                        <ul id="who-list" class="combo-list" role="listbox" aria-label="Matching people" hidden></ul>
                        <div class="combo-selected" data-people-selected role="status" hidden></div>
                    </div>
                </div>
                <span class="hint" id="who-hint">Suggestions appear as you type, with each person's site. Only active people with an email address can receive new loans.</span>
            </fieldset>
            <div class="form-actions"><button type="submit" class="@(hasTarget ? "" : "btn--primary")">Find</button></div>
        </form>

        @if (Model.TargetError is not null)
        {
            <div class="alert alert--error" role="alert">@Ui.Icon("error", 18, 2)<div class="alert-body">@Model.TargetError</div></div>
        }
        else if (Model.Matches.Count > 0)
        {
            <section class="card card--flush" aria-labelledby="matches-h">
                <div class="card-header">
                    <h2 id="matches-h">Several items match “@Model.Tag”</h2>
                    <span class="card-note">Choose one to continue.</span>
                </div>
                <ul class="picker">
                    @foreach (var m in Model.Matches)
                    {
                        <li>
                            @if (m.CanCheckOut)
                            {
                                <a class="picker-option" asp-page="Checkout" asp-route-assetId="@(m.Kind == "asset" ? m.Id : null)" asp-route-poolId="@(m.Kind == "pool" ? m.Id : null)"
                                   asp-route-who="@Model.Who" asp-route-holderId="@Model.HolderId" asp-route-type="@Model.FilterType" asp-route-site="@Model.FilterSite">
                                    <span class="picker-text">
                                        <span class="picker-name"><span class="mono">@m.Key</span> <span class="badge badge--info">@m.SiteKey</span> <span class="badge">@m.Status</span></span>
                                        <span class="picker-meta">@string.Join(" · ", new[] { m.Title, m.Type, m.Description }.Where(x => !string.IsNullOrEmpty(x)))</span>
                                    </span>
                                </a>
                            }
                            else
                            {
                                <div class="picker-option picker-option--inactive" aria-disabled="true">
                                    <span class="picker-text">
                                        <span class="picker-name"><span class="mono">@m.Key</span> <span class="badge badge--info">@m.SiteKey</span> <span class="badge badge--muted">@m.Status@(m.Holder is null ? "" : $" to {m.Holder}")</span></span>
                                        <span class="picker-meta">@string.Join(" · ", new[] { m.Title, m.Type, m.Description }.Where(x => !string.IsNullOrEmpty(x)))</span>
                                    </span>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
        else if (hasTarget)
        {
            <form method="post" id="checkout-confirm" class="card" aria-labelledby="confirm-h">
                <h2 id="confirm-h" class="visually-hidden">Confirm</h2>
                @if (Model.Asset is { } a)
                {
                    <input type="hidden" name="Input.AssetId" value="@a.Id" />
                }
                else if (Model.Pool is { } pool)
                {
                    <input type="hidden" name="Input.PoolId" value="@pool.Id" />
                }
                <fieldset>
                    <legend>Choose the person</legend>
                    @if (Model.People.Count == 0)
                    {
                        <p class="picker-empty">Search for a person above.</p>
                    }
                    else
                    {
                        <ul class="picker">
                            @foreach (var person in Model.People)
                            {
                                <li>
                                    <label class="picker-option">
                                        <input type="radio" name="Input.HolderId" value="@person.Id" required checked="@(Model.Input.HolderId == person.Id)" />
                                        <span class="avatar" aria-hidden="true">@Ui.Initials(person.DisplayName)</span>
                                        <span class="picker-text">
                                            <span class="picker-name">
                                                @person.DisplayName
                                                @if (person.SiteKey is not null)
                                                {
                                                    <span class="badge badge--info">@person.SiteKey</span>
                                                    @if (itemSiteKey is not null && !string.Equals(person.SiteKey, itemSiteKey, StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <span class="badge badge--warning">Other site than the item (@itemSiteKey)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge badge--muted">No site</span>
                                                }
                                            </span>
                                            <span class="picker-meta">@person.Username · @person.Email@(person.SiteName is null ? "" : $" · {person.SiteName}")@(string.IsNullOrEmpty(person.JobTitle) ? "" : $" · {person.JobTitle}")</span>
                                        </span>
                                        <span class="picker-check">@Ui.Icon("check", 18, 2.4)</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    }
                </fieldset>
                <fieldset>
                    <legend><span class="step-number">3.</span> Terms</legend>
                    <div class="fields">
                        <div class="field">
                            <label for="due">Due date <span class="optional">(optional)</span></label>
                            <input id="due" name="Input.DueDate" type="date" value="@Model.Input.DueDate?.ToString("yyyy-MM-dd")" />
                            <span class="hint">Overdue from the start of this day at the item's site.</span>
                        </div>
                        <div class="field">
                            <label for="cond">Condition</label>
                            <input id="cond" name="Input.Condition" maxlength="200" value="@Model.Input.Condition" />
                        </div>
                        <div class="field span-all">
                            <label for="note">Note <span class="optional">(optional)</span></label>
                            <input id="note" name="Input.Note" maxlength="2000" value="@Model.Input.Note" />
                        </div>
                    </div>
                </fieldset>
            </form>
        }
    </div>

    @if (hasTarget)
    {
        <aside class="col-side" aria-label="Summary">
            <div class="card summary">
                <h2>Summary</h2>
                @if (Model.Asset is { } a)
                {
                    <div class="summary-qty">
                        <span class="summary-big">1×</span>
                        <span class="summary-item"><span class="mono">@a.Tag</span><span class="secondary">@(string.IsNullOrEmpty(a.Title) ? "" : a.Title + " ")(@a.Type) at @a.Site?.Key</span></span>
                    </div>
                    <dl class="dl-list">
                        <div><dt>Item</dt><dd>Tagged asset · quantity <strong>1</strong></dd></div>
                        <div><dt>Site</dt><dd>@a.Site?.Key – @a.Site?.Name</dd></div>
                        <div><dt>Emails</dt><dd>Holder + IT mailbox</dd></div>
                    </dl>
                }
                else if (Model.Pool is { } p)
                {
                    <div class="summary-item"><span class="mono">@p.Sku</span><span class="secondary">@p.Description at @p.Site?.Key</span></div>
                    <div class="field">
                        <label for="qty">Quantity</label>
                        <div class="stepper" data-stepper>
                            <button type="button" aria-label="Decrease quantity" data-step="-1">−</button>
                            <input id="qty" name="Input.Quantity" type="number" min="1" max="@p.Available" value="@Model.Quantity" required form="checkout-confirm" aria-describedby="qty-hint" />
                            <button type="button" aria-label="Increase quantity" data-step="1">+</button>
                        </div>
                        <span class="hint" id="qty-hint"><strong>@p.Available</strong> available · @p.Outstanding out · @p.OnHand on hand</span>
                    </div>
                    <dl class="dl-list">
                        <div><dt>Pool</dt><dd>@p.Type at @p.Site?.Key</dd></div>
                        <div><dt>Emails</dt><dd>Holder + IT mailbox</dd></div>
                    </dl>
                }
                @if (Model.DirectoryStale)
                {
                    <div class="note" role="note">@Ui.Icon("warning", 16, 2)<span>@staleText</span></div>
                }
                <button type="submit" form="checkout-confirm" class="btn--primary btn--block" disabled="@(Model.People.Count == 0)">Confirm checkout</button>
                <a class="text-link text-link--center" asp-page="Index">Cancel</a>
            </div>
        </aside>
    }
</div>
