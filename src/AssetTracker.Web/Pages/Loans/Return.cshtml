@page "{id:int}"
@model AssetTracker.Web.Pages.Loans.ReturnModel
@{
    var l = Model.History.Loan;
    ViewData["Title"] = $"Return loan #{l.Id}";
}
<h1>Return loan #@l.Id</h1>
<p>
    @(l.Asset is { } a ? $"{a.Tag} – {a.Description}" : $"{l.Pool?.Sku} (pool at {l.Pool?.Site?.Key})")
    held by <strong>@(l.Holder?.DisplayName ?? l.HolderNameSnapshot)</strong>@(l.Holder is { IsActive: false } ? " (inactive)" : "")
</p>
<div class="balances">
    <div><strong>@l.Quantity</strong>Checked out</div>
    <div><strong>@l.ReturnedQuantity</strong>Returned</div>
    <div><strong>@l.OutstandingQuantity</strong>Outstanding</div>
</div>
<div asp-validation-summary="All" class="error"></div>
@if (!l.IsOpen)
{
    <p class="muted">This loan has already been fully returned.</p>
}
else
{
    <form method="post">
        <div class="form-grid">
            @if (l.PoolId is not null)
            {
                <label asp-for="Input.Quantity"><strong>Quantity returned now</strong></label>
                <input asp-for="Input.Quantity" type="number" min="1" max="@l.OutstandingQuantity" required class="qty" />
            }
            <label asp-for="Input.ReturnedAt">Returned at (UTC, blank = now)</label>
            <input asp-for="Input.ReturnedAt" type="datetime-local" />
            <label asp-for="Input.Condition">Condition</label>
            <input asp-for="Input.Condition" maxlength="200" />
            <label asp-for="Input.Note">Note</label>
            <input asp-for="Input.Note" maxlength="2000" />
            @if (l.AssetId is not null)
            {
                <label asp-for="Input.MarkUnavailable">Mark unavailable (repair / retirement)</label>
                <input asp-for="Input.MarkUnavailable" type="checkbox" />
            }
            <div class="full"><button type="submit">Record return</button> <a asp-page="Details" asp-route-id="@l.Id">Cancel</a></div>
        </div>
    </form>
}
