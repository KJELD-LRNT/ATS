@page
@model AssetTracker.Web.Pages.Reports.InventoryModel
@{
    ViewData["Title"] = "Inventory report";
}
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-page="Index">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Inventory</span></nav>
<header class="page-header">
    <div class="page-heading">
        <h1>Inventory report</h1>
        <p class="page-subtitle">The CSV export contains tagged assets and pool balances for the current filters (a state filter exports tagged assets only).</p>
    </div>
</header>
<nav class="view-switch" aria-label="Report view">
    @if (Model.ShowPools)
    {
        <a asp-route-view="" asp-route-q="@Model.Q" asp-route-siteId="@Model.SiteId" asp-route-type="@Model.Type">Tagged assets</a>
        <span aria-current="page">Pool balances</span>
    }
    else
    {
        <span aria-current="page">Tagged assets</span>
        <a asp-route-view="pools" asp-route-q="@Model.Q" asp-route-siteId="@Model.SiteId" asp-route-type="@Model.Type">Pool balances</a>
    }
</nav>
<form method="get" class="filters" role="search">
    @if (Model.ShowPools) { <input type="hidden" name="view" value="pools" /> }
    <div class="field field--grow">
        <label for="f-q">Search</label>
        <input id="f-q" name="q" value="@Model.Q" type="search" placeholder="@Model.SearchPlaceholder" />
    </div>
    <div class="field">
        <label for="SiteId">Site</label>
        <select name="siteId" asp-for="SiteId" asp-items="Model.Sites"><option value="">All</option></select>
    </div>
    <div class="field">
        <label for="Type">Type</label>
        <select name="type" asp-for="Type" asp-items="InventoryUi.EnumOptions<AssetType>()"><option value="">All</option></select>
    </div>
    @if (!Model.ShowPools)
    {
        <div class="field">
            <label for="State">State</label>
            <select name="state" asp-for="State" asp-items="InventoryUi.EnumOptions<AssetState>()"><option value="">All</option></select>
        </div>
    }
    <div class="filters-actions">
        <button type="submit">Filter</button>
        <a class="btn" asp-all-route-data="Model.ExportRoute()">@Ui.Icon("download", 16, 2) Export CSV</a>
    </div>
</form>
<section class="card card--flush" aria-label="Inventory">
    <div class="table-wrap">
        @if (Model.Pools is { } pools)
        {
            <table>
                <thead>
                <tr><th scope="col">SKU</th><th scope="col">Type</th><th scope="col">Description</th><th scope="col">Site</th><th scope="col" class="num">Available</th><th scope="col" class="num">Outstanding</th><th scope="col" class="num">On hand</th></tr>
                </thead>
                <tbody>
                @foreach (var p in pools.Items)
                {
                    <tr>
                        <td class="mono nowrap">@p.Sku</td><td>@p.Type</td><td>@p.Description</td><td>@p.SiteKey</td>
                        <td class="num"><strong>@p.Available</strong></td>
                        <td class="num"><strong>@p.Outstanding</strong></td>
                        <td class="num">@p.OnHand</td>
                    </tr>
                }
                @if (pools.TotalCount == 0)
                {
                    <tr><td colspan="7" class="empty">No pools match.</td></tr>
                }
                </tbody>
            </table>
        }
        else if (Model.Assets is { } assets)
        {
            <table>
                <thead>
                <tr><th scope="col">Tag</th><th scope="col">Type</th><th scope="col">Description</th><th scope="col">Site</th><th scope="col">State</th><th scope="col">Serial</th><th scope="col">Current holder</th><th scope="col">Due</th></tr>
                </thead>
                <tbody>
                @foreach (var a in assets.Items)
                {
                    <tr>
                        <td class="mono nowrap">@a.Tag</td><td>@a.Type</td><td>@a.Description</td><td>@a.SiteKey</td><td>@Ui.Pill(a.State)</td>
                        <td class="mono">@a.SerialNumber</td>
                        <td><div class="cell-stack"><span>@a.HolderName</span><span class="cell-sub">@a.HolderUsername</span></div></td>
                        <td class="nowrap">@a.DueDate?.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
                @if (assets.TotalCount == 0)
                {
                    <tr><td colspan="8" class="empty">No assets match.</td></tr>
                }
                </tbody>
            </table>
        }
    </div>
    <partial name="_Pager" model="Model.Pager" />
</section>
