@page
@model AssetTracker.Web.Pages.Reports.AssignmentsModel
@{
    ViewData["Title"] = "Current assignments";
}
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-page="Index">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Current assignments</span></nav>
<header class="page-header">
    <div class="page-heading">
        <h1>Current assignments</h1>
        <p class="page-subtitle">Open loans of tagged assets and pool quantities. Pool rows show the quantity still outstanding.</p>
    </div>
</header>
<partial name="_ReportFilters" model="Model" />
<section class="card card--flush" aria-label="Assignments">
    <partial name="_LoanTable" model="new LoanTableModel(Model.Results.Items)" />
    <partial name="_Pager" model="Model.Pager" />
</section>
