@model AssetTracker.Web.Pages.Reports.LoanTableModel
@{
    var cols = 9 + (Model.Overdue ? 1 : 0) + (Model.History ? 3 : 0);
}
<table>
    <thead>
    <tr>
        <th>Item</th><th>Type</th><th>Site</th><th class="num">Outstanding</th>
        <th>Started</th><th>Due</th>
        @if (Model.Overdue) { <th class="num">Days overdue</th> }
        @if (Model.History) { <th>Returned</th> }
        <th>Holder</th><th>Holder details</th><th>Holder site</th>
        @if (Model.History) { <th class="num">Corrections</th><th>Latest correction reason</th> }
    </tr>
    </thead>
    <tbody>
    @foreach (var r in Model.Rows)
    {
        <tr>
            <td>
                @if (r.IsPool)
                {
                    <span>Pool <strong>@r.PoolSku</strong></span>
                }
                else
                {
                    <strong>@r.AssetTag</strong>
                }
                <div class="muted">@r.ItemDescription</div>
            </td>
            <td>@r.Type</td>
            <td>@r.SiteKey</td>
            <td class="num">
                <strong>@r.OutstandingQuantity</strong>
                @if (r.IsPool) { <div class="muted">of @r.Quantity</div> }
            </td>
            <td>@r.StartedAt.ToString("yyyy-MM-dd")</td>
            <td>@(r.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
            @if (Model.Overdue) { <td class="num"><strong>@r.DaysOverdue</strong></td> }
            @if (Model.History) { <td>@(r.ClosedAt?.ToString("yyyy-MM-dd") ?? "open")</td> }
            <td>
                @r.HolderDisplayName
                @if (!r.HolderActive) { <span class="muted">(inactive)</span> }
                @if (r.HolderNameSnapshot != r.HolderDisplayName) { <div class="muted">at checkout: @r.HolderNameSnapshot</div> }
            </td>
            <td>@r.HolderUsername<div class="muted">@r.HolderEmail</div><div class="muted">@r.HolderJobTitle</div></td>
            <td>@r.HolderSiteKey</td>
            @if (Model.History)
            {
                <td class="num">@r.CorrectionCount</td>
                <td>@r.LatestCorrectionReason</td>
            }
        </tr>
    }
    @if (Model.Rows.Count == 0)
    {
        <tr><td colspan="@cols" class="muted">Nothing matches.</td></tr>
    }
    </tbody>
</table>
