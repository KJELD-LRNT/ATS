@page
@model AssetTracker.Web.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
    var s = Model.Summary;
}
<h1>Reports</h1>
<div class="balances">
    <div><strong>@s.OpenLoans</strong>open assignments</div>
    <div><strong>@s.OpenPoolUnits</strong>pool units out</div>
    <div><strong>@s.OverdueLoans</strong>overdue or due today (site-local date)</div>
</div>
<ul>
    <li><a asp-page="Inventory">Inventory</a> — tagged assets by site, type and state; pool balances</li>
    <li><a asp-page="Assignments">Current assignments</a> — open tagged and pool loans with holder details</li>
    <li><a asp-page="Overdue">Overdue</a> — open loans due today or earlier (site-local date)</li>
    <li><a asp-page="History">History</a> — all loans with corrections; loan and event level exports</li>
</ul>
<p class="muted">Every report has a CSV export of the current filters. Exports are audited.</p>

<h2>Tagged assets</h2>
<table>
    <thead><tr><th>Site</th><th>Type</th><th>State</th><th class="num">Count</th></tr></thead>
    <tbody>
    @foreach (var a in s.Assets)
    {
        <tr><td>@a.SiteKey</td><td>@a.Type</td><td>@a.State</td><td class="num">@a.Count</td></tr>
    }
    @if (s.Assets.Count == 0)
    {
        <tr><td colspan="4" class="muted">No tagged assets.</td></tr>
    }
    </tbody>
</table>

<h2>Pool totals</h2>
<table>
    <thead><tr><th>Site</th><th>Type</th><th class="num">Pools</th><th class="num">Available</th><th class="num">Outstanding</th><th class="num">On hand</th></tr></thead>
    <tbody>
    @foreach (var p in s.Pools)
    {
        <tr>
            <td>@p.SiteKey</td><td>@p.Type</td><td class="num">@p.Pools</td>
            <td class="num"><strong>@p.Available</strong></td><td class="num"><strong>@p.Outstanding</strong></td>
            <td class="num">@p.OnHand</td>
        </tr>
    }
    @if (s.Pools.Count == 0)
    {
        <tr><td colspan="6" class="muted">No pools.</td></tr>
    }
    </tbody>
</table>
