@page
@model AssetTracker.Web.Pages.Reports.OverdueModel
@{
    ViewData["Title"] = "Overdue";
}
<h1>Overdue assignments</h1>
<p class="muted">Open loans whose due date is today or earlier in the local calendar of the loan's site: an item is overdue from the start of its due date. "Due today" means 0 days past the due date. Partially returned pool loans stay overdue for the outstanding quantity.</p>
<partial name="_ReportFilters" model="Model" />
<partial name="_LoanTable" model="new LoanTableModel(Model.Results.Items, Overdue: true)" />
<partial name="_Pager" model="Model.Pager" />
<p><a asp-page="Index">Back to reports</a></p>
