@page
@model AssetTracker.Web.Pages.Reports.HistoryModel
@{
    ViewData["Title"] = "Loan history";
}
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-page="Index">Reports</a><span aria-hidden="true">/</span><span aria-current="page">Loan history</span></nav>
<header class="page-header">
    <div class="page-heading">
        <h1>Loan history</h1>
        <p class="page-subtitle">All loans, open and returned, in their effective (corrected) state. Tagged assets are listed by their current site, including earlier holders.</p>
    </div>
    <div class="page-actions">
        <a class="btn" asp-all-route-data="@Model.ExportRoute(HistoryModel.EventsHandler)">@Ui.Icon("download", 16, 2) Export event history CSV</a>
    </div>
</header>
<p class="hint">The event history export has one row per event, including corrections and the event each supersedes.</p>
<partial name="_ReportFilters" model="Model" />
<section class="card card--flush" aria-label="Loan history">
    <partial name="_LoanTable" model="new LoanTableModel(Model.Results.Items, History: true)" />
    <partial name="_Pager" model="Model.Pager" />
</section>
