@page
@using AssetTracker.Core.Domain
@model AssetTracker.Web.Pages.Ops.MailModel
@{
    ViewData["Title"] = "Mail queue";
    var s = Model.Status;
}
<header class="page-header">
    <div class="page-heading">
        <h1>Mail queue</h1>
        <p class="page-subtitle">Notifications waiting in the outbox, and the ones that failed or were skipped.</p>
    </div>
    @if (s.FailedCount > 0)
    {
        <form method="post" asp-page-handler="RequeueAll" class="page-actions">
            <button type="submit" class="btn--primary">Requeue all failed (@s.FailedCount)</button>
        </form>
    }
</header>

@if (Model.Message is not null)
{
    <div class="alert alert--warning" role="status">@Ui.Icon("warning", 18, 2)<div class="alert-body">@Model.Message</div></div>
}

<section class="kpis" aria-label="Queue status">
    <div class="kpi"><span class="kpi-label">Pending</span><span class="kpi-value" id="pending-count">@s.PendingCount</span></div>
    <div class="kpi @(s.FailedCount > 0 ? "kpi--overdue" : "")"><span class="kpi-label">Failed (retries exhausted)</span><span class="kpi-value" id="failed-count">@s.FailedCount</span></div>
    <div class="kpi"><span class="kpi-label">Skipped recipients</span><span class="kpi-value" id="skipped-count">@s.SkippedCount</span></div>
</section>
<section class="card card--flush" aria-label="Queue details">
    <table class="kv-table">
        <tr><th scope="row">Oldest pending</th><td>@(s.OldestPendingAge is { } age ? $"{(int)age.TotalMinutes} min (queued {s.OldestPendingCreatedAt:yyyy-MM-dd HH:mm} UTC)" : "none")</td></tr>
        <tr><th scope="row">Last error</th><td>@(s.LastError is null ? "none" : $"{s.LastErrorAt:yyyy-MM-dd HH:mm} UTC: {s.LastError}")</td></tr>
    </table>
</section>

<section class="card card--flush" aria-labelledby="rows-h">
    <div class="card-header">
        <h2 id="rows-h">Failed and skipped notifications</h2>
        <span class="card-note">Skipped rows had no usable recipient (inactive holder, missing or invalid address, or IT mailbox not configured). They are not retried.</span>
    </div>
    @if (Model.Rows.Total == 0)
    {
        <div class="empty-state"><strong>None.</strong><span>Nothing has failed or been skipped.</span></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                <tr><th scope="col">Id</th><th scope="col">Created (UTC)</th><th scope="col">Kind</th><th scope="col">Status</th><th scope="col">Recipient</th><th scope="col">Subject</th><th scope="col">Loan</th><th scope="col" class="num">Attempts</th><th scope="col">Reason / last error</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Rows.Rows)
                {
                    <tr>
                        <td class="mono">@r.Id</td>
                        <td class="nowrap">@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@r.Kind</td>
                        <td>@Ui.Pill(r.Status)</td>
                        <td>@(r.RecipientEmail ?? "(none)")</td>
                        <td>@r.Subject</td>
                        <td>@if (r.LoanId is not null) { <a class="mono" asp-page="/Loans/Details" asp-route-id="@r.LoanId">#@r.LoanId</a> }</td>
                        <td class="num">@r.Attempts</td>
                        <td>@(r.Status == NotificationStatus.Skipped ? r.SkipReason : r.LastError)</td>
                        <td class="actions-cell">
                            @if (r.Status == NotificationStatus.Failed)
                            {
                                <form method="post" asp-page-handler="Requeue" asp-route-id="@r.Id">
                                    <button type="submit" class="btn--sm">Requeue</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <nav class="pager" aria-label="Pages">
            <span>Page @Model.Rows.Page of @Model.Rows.PageCount (@Model.Rows.Total rows)</span>
            <span class="pager-links">
                @if (Model.Rows.Page > 1) { <a class="btn btn--sm" asp-route-p="@(Model.Rows.Page - 1)">Previous</a> }
                @if (Model.Rows.Page < Model.Rows.PageCount) { <a class="btn btn--sm" asp-route-p="@(Model.Rows.Page + 1)">Next</a> }
            </span>
        </nav>
    }
</section>
