@page "{id:int}"
@model AssetTracker.Web.Pages.Workplace.ReplaceModel
@{
    ViewData["Title"] = "Replace drawing";
}
<header class="page-header">
    <div class="page-heading">
        <h1>Replace drawing: @Model.View!.Floor.Name</h1>
        <p class="page-subtitle">@Model.View.SiteKey. Upload a revised SVG of this floor. Workspots are matched on their id in the drawing: new seats are added, seats that are gone are switched off (never deleted), labels and zones stay.</p>
    </div>
</header>
<div asp-validation-summary="ModelOnly" class="alert alert--error"></div>
<section class="card" aria-labelledby="replace-h">
    <h2 id="replace-h" class="visually-hidden">Replace drawing</h2>
    <form method="post" enctype="multipart/form-data" class="stack form-narrow">
        <div class="field">
            <label for="Drawing">SVG drawing</label>
            <input asp-for="Drawing" type="file" accept=".svg,image/svg+xml" />
            <span class="hint">At most @ImportModel.MaxMegabytes MB.</span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn--primary">Replace drawing</button>
            <a class="btn" asp-page="Floor" asp-route-id="@Model.View.Floor.Id">Cancel</a>
        </div>
    </form>
</section>
