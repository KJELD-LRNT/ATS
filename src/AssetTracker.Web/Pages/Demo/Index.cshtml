@page
@model AssetTracker.Web.Pages.Demo.IndexModel
@{
    ViewData["Title"] = "Demo controls";
    var roles = Model.CurrentRoles;
}
<header class="page-header">
    <div class="page-heading">
        <h1>Demo controls</h1>
        <p class="page-subtitle">This app runs in <strong>local demo mode</strong>: every person, site and asset is fictional, mail goes to the
            <a asp-page="/Demo/Mailbox">demo mailbox</a> instead of a relay, and the background jobs run inside this process.
            See <code>docs/testing-guide.md</code> for test scenarios.</p>
    </div>
</header>

@if (Model.Message is not null)
{
    <div class="alert alert--success" role="status" id="demo-message">@Ui.Icon("check", 18, 2.4)<div class="alert-body">@Model.Message</div></div>
}

<div class="demo-grid">
    <section class="demo-panel" id="demo-identity" aria-labelledby="demo-identity-h">
        <h2 id="demo-identity-h">Who am I?</h2>
        <p>Currently <strong>@Model.Current.UserName</strong> with roles
            <strong id="demo-current-roles">@IndexModel.RoleNames(roles)</strong>.
            Roles are given in the app, exactly like on a server (Admin → System roles); the person decides which manager sites apply.</p>
        <form method="post" asp-page-handler="Roles" class="stack" id="demo-roles-form">
            <fieldset class="demo-roles">
                <legend>Roles of @Model.Current.UserName (any combination, including none)</legend>
                <label class="check"><input type="checkbox" name="it" value="true" checked="@roles.HasFlag(AppRoles.It)" /> IT</label>
                <label class="check"><input type="checkbox" name="manager" value="true" checked="@roles.HasFlag(AppRoles.Manager)" /> Manager</label>
                <label class="check"><input type="checkbox" name="admin" value="true" checked="@roles.HasFlag(AppRoles.Admin)" /> Admin</label>
                <label class="check"><input type="checkbox" name="facility" value="true" checked="@roles.HasFlag(AppRoles.Facility)" /> Facility</label>
            </fieldset>
            <p class="hint">The ticks replace this person's roles in the demo database. <em>Reset demo data</em> gives the demo user IT and Admin again.</p>
            <div class="form-actions"><button type="submit" id="demo-apply-roles" class="btn--primary">Save roles</button></div>
        </form>
        <form method="post" asp-page-handler="Identity" class="stack" id="demo-person-form">
            <div class="field">
                <label for="personSid">Act as person</label>
                <select id="personSid" name="personSid">
                    @foreach (var p in Model.People)
                    {
                        <option value="@p.Sid" selected="@(p.Sid == Model.Current.Sid)">@p.Label</option>
                    }
                </select>
            </div>
            <p class="hint">Tip: <em>Demo Manager (AMS)</em> has the Manager role and the Amsterdam site, so acting as them shows what a
                site manager sees. The person marked <em>roles: Facility</em> shows the Facility view (floor plans only).</p>
            <div class="form-actions"><button type="submit" id="demo-apply-identity">Act as this person</button></div>
        </form>
    </section>

    <div class="stack">
        <section class="demo-panel" id="demo-time" aria-labelledby="demo-time-h">
            <h2 id="demo-time-h">Time travel</h2>
            <p>Demo time: <strong>@Model.DemoUtcNow.ToString("yyyy-MM-dd HH:mm") UTC</strong>
                @(Model.Offset > TimeSpan.Zero ? $"(real time + {Model.Offset.TotalDays:0.#} days)" : "(real time)")</p>
            <div class="table-wrap">
                <table>
                    <thead><tr><th scope="col">Site</th><th scope="col">Timezone</th><th scope="col">Local date and time</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.SiteTimes)
                    {
                        <tr><td><span class="mono">@s.Key</span> — @s.Name</td><td>@s.TimeZone</td><td class="nowrap">@s.LocalNow.ToString("ddd yyyy-MM-dd HH:mm")</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="hint">Overdue status, due dates, reports and reminders all follow this clock. Reminders are queued once per
                loan, site-local day and recipient after 08:00 site time.</p>
            <div class="form-actions">
                <form method="post" asp-page-handler="Travel" class="demo-inline">
                    <input type="hidden" name="days" value="1" />
                    <button type="submit" id="demo-plus-1">+1 day</button>
                </form>
                <form method="post" asp-page-handler="Travel" class="demo-inline">
                    <input type="hidden" name="days" value="7" />
                    <button type="submit" id="demo-plus-7">+7 days</button>
                </form>
                <form method="post" asp-page-handler="TravelReset" class="demo-inline">
                    <button type="submit" id="demo-time-reset">Reset to now</button>
                </form>
            </div>
        </section>

        <section class="demo-panel" id="demo-superadmin" aria-labelledby="demo-superadmin-h">
            <h2 id="demo-superadmin-h">Super admin (not an AD account)</h2>
            <p>Sign in on <a href="/superadmin">/superadmin</a> with username <code id="demo-superadmin-user">@AssetTracker.Core.Security.SuperAdmin.UserName</code>
                and password <code id="demo-superadmin-password">@AssetTracker.Core.Security.SuperAdmin.DemoPassword</code>.
                It has the Admin role only (settings, roles, sites, sync, privacy) and replaces the demo user in this browser until you sign out.</p>
            <p class="hint">This password exists only in the demo. On a server the password is set with the setup command, which refuses it,
                as does the password change in the app. <em>Reset demo data</em> puts it back.</p>
        </section>

        <section class="demo-panel" id="demo-data" aria-labelledby="demo-data-h">
            <h2 id="demo-data-h">Demo data</h2>
            <p>Data folder: <code>@Model.DataDirectory</code> (database <code>demo.db</code>, mail in <code>mail</code>, keys in <code>keys</code>).
                Demo mailbox: @Model.MailCount message(s).</p>
            <form method="post" asp-page-handler="Reset" data-confirm="Delete all demo data and mail and seed it again?">
                <button type="submit" id="demo-reset" class="btn--danger">Reset demo data</button>
            </form>
        </section>
    </div>
</div>
