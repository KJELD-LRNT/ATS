@page
@model AssetTracker.Web.Pages.Keys.RegisterModel
@{ ViewData["Title"] = "Buildings & keys"; var b = Model.Board; }
<header class="page-header"><div class="page-heading"><h1>Buildings & keys</h1><p class="secondary">Set up buildings and rooms, then define what each key opens.</p></div></header>
<partial name="_Nav" />
@if(Model.Message is {} message){<div class="alert alert--success" role="status">@message</div>}
<section class="card"><h2>Buildings</h2>
@foreach(var x in b.Buildings){<details><summary>@x.Site!.Key / @x.Name @(!x.IsActive ? "(archived)" : "")</summary><form method="post" asp-page-handler="Building" class="fields"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="siteId" value="@x.SiteId"/><div class="field"><label for="building-@x.Id">Name</label><input id="building-@x.Id" name="name" value="@x.Name" required maxlength="200"/></div><label class="check"><input type="checkbox" name="active" value="true" checked="@x.IsActive"/> Active</label><button>Save building</button></form></details>}
<form method="post" asp-page-handler="Building" class="fields"><input type="hidden" name="active" value="true"/><div class="field"><label for="site">Site</label><select id="site" name="siteId" required>@foreach(var s in b.Sites.Where(x => x.IsActive)){<option value="@s.Id">@s.Name</option>}</select></div><div class="field"><label for="building-name">New building name</label><input id="building-name" name="name" required maxlength="200"/></div><div class="form-actions"><button>Add building</button></div></form>
</section>
<section class="card"><h2>Rooms</h2>
@foreach(var x in b.Rooms){<details><summary>@b.RoomLabel(x.Id) @(!x.IsActive ? "(archived)" : "")</summary><form method="post" asp-page-handler="Room" class="fields"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="buildingId" value="@x.BuildingId"/><input type="hidden" name="floorId" value="@x.FloorId"/><input type="hidden" name="drawingRoomId" value="@x.DrawingRoomId"/><div class="field"><label for="code-@x.Id">Code</label><input id="code-@x.Id" name="code" value="@x.Code" required maxlength="64"/></div><div class="field"><label for="room-@x.Id">Name</label><input id="room-@x.Id" name="name" value="@x.Name" required maxlength="200"/></div><label class="check"><input type="checkbox" name="active" value="true" checked="@x.IsActive"/> Active</label><button>Save room</button></form></details>}
<form method="post" asp-page-handler="Room" class="fields"><input type="hidden" name="active" value="true"/><div class="field"><label for="room-building">Building</label><select id="room-building" name="buildingId" required>@foreach(var x in b.Buildings.Where(x => x.IsActive)){<option value="@x.Id">@x.Site!.Key / @x.Name</option>}</select></div><div class="field"><label for="room-code">Room code</label><input id="room-code" name="code" required maxlength="64"/></div><div class="field"><label for="room-name">Room name</label><input id="room-name" name="name" required maxlength="200"/></div><div class="field"><label for="floor">Floor plan (optional)</label><select id="floor" name="floorId"><option value="">No drawing link</option>@foreach(var x in b.Floors){<option value="@x.Id">@x.Name</option>}</select></div><div class="field"><label for="drawing-room">Room ID in drawing (optional)</label><input id="drawing-room" name="drawingRoomId" maxlength="100"/></div><div class="form-actions"><button>Add room</button></div></form>
</section>
<section class="card"><h2>Key definitions</h2><p class="hint">One definition for each key pattern; register each physical copy on its detail page.</p>
<div class="table-wrap"><table><thead><tr><th>Building</th><th>Key</th><th>Rooms opened</th><th>Status</th></tr></thead><tbody>@foreach(var x in b.Definitions){<tr><td>@x.Building!.Name</td><td><a asp-page="Definition" asp-route-id="@x.Id">@x.Code — @x.Name</a></td><td>@b.RoomsFor(x.Id).Count</td><td>@(x.IsActive ? "Active" : "Archived")</td></tr>}</tbody></table></div>
<form method="post" asp-page-handler="Definition" class="fields"><input type="hidden" name="active" value="true"/><div class="field"><label for="key-building">Building</label><select id="key-building" name="buildingId" required>@foreach(var x in b.Buildings.Where(x => x.IsActive)){<option value="@x.Id">@x.Name</option>}</select></div><div class="field"><label for="key-code">Key code</label><input id="key-code" name="code" required maxlength="64"/></div><div class="field"><label for="key-name">Key name</label><input id="key-name" name="name" required maxlength="200"/></div><div class="form-actions"><button>Add key definition</button></div></form>
</section>
