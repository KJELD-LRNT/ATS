@page
@model AssetTracker.Web.Pages.Audit.IndexModel
@{
    ViewData["Title"] = "Audit log";
}
<header class="page-header">
    <div class="page-heading">
        <h1>Audit log</h1>
        <p class="page-subtitle">Read-only. Audit records cannot be edited or deleted. Times and date filters are UTC.</p>
    </div>
</header>

<form method="get" class="filters" role="search">
    <div class="field">
        <label for="f-action">Action</label>
        <input id="f-action" name="action" value="@Model.Action" placeholder="e.g. grant.add or grant.*" class="mono" />
    </div>
    <div class="field">
        <label for="f-entity">Entity</label>
        <select id="f-entity" name="entity">
            <option value="">(any)</option>
            @foreach (var t in Model.EntityTypes)
            {
                <option value="@t" selected="@(t == Model.Entity)">@t</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="f-entityId">Entity id</label>
        <input id="f-entityId" name="entityId" value="@Model.EntityId" class="mono" />
    </div>
    <div class="field">
        <label for="f-actor">Actor</label>
        <input id="f-actor" name="actor" value="@Model.Actor" placeholder="DOMAIN\user" />
    </div>
    <div class="field">
        <label for="f-from">From</label>
        <input id="f-from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="field">
        <label for="f-to">To</label>
        <input id="f-to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="filters-actions">
        <button type="submit">Filter</button>
        <a class="text-link" asp-page="/Audit/Index">Clear</a>
    </div>
</form>

<section class="card card--flush" aria-labelledby="audit-h">
    <div class="card-header"><h2 id="audit-h">@Model.Result.TotalCount event(s).</h2></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">#</th><th scope="col">When (UTC)</th><th scope="col">Actor</th><th scope="col">Action</th><th scope="col">Entity</th><th scope="col">Site</th><th scope="col">Reason</th><th scope="col">Details</th><th scope="col">Correlation</th></tr></thead>
            <tbody>
            @foreach (var e in Model.Result.Items)
            {
                <tr>
                    <td class="mono">@e.Id</td>
                    <td class="nowrap">@e.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@e.Actor</td>
                    <td class="mono nowrap">@e.Action</td>
                    <td class="nowrap">@e.EntityType @e.EntityId</td>
                    <td>@e.SiteId</td>
                    <td>@e.Reason</td>
                    <td><code class="details">@e.DetailsJson</code></td>
                    <td><small class="mono muted">@e.CorrelationId</small></td>
                </tr>
            }
            @if (Model.Result.Items.Count == 0)
            {
                <tr><td colspan="9" class="empty">No audit events match.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <nav class="pager" aria-label="Pages">
        <span>Page @Model.Result.Page of @Model.Result.PageCount</span>
        <span class="pager-links">
            @if (Model.Result.HasPrevious) { <a class="btn btn--sm" asp-page="/Audit/Index" asp-all-route-data="Model.RouteFor(Model.Result.Page - 1)">Newer</a> }
            @if (Model.Result.HasNext) { <a class="btn btn--sm" asp-page="/Audit/Index" asp-all-route-data="Model.RouteFor(Model.Result.Page + 1)">Older</a> }
        </span>
    </nav>
</section>
