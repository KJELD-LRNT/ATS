{
  "AllowedHosts": "<INTERNAL-DNS-NAME>",
  "ConnectionStrings": {
    "AssetTracker": "Server=<SQL-HOST>\\SQLEXPRESS;Database=AssetTracker;Integrated Security=True;Encrypt=True"
  },
  "Clock": {
    "TimeZoneId": "<CLIENT-TIMEZONE-ID>"
  },
  "Roles": {
    "ItGroupSids": [ "<IT-GROUP-SID>" ],
    "ManagerGroupSids": [ "<MANAGER-GROUP-SID>" ],
    "AdminGroupSids": [ "<ADMIN-GROUP-SID>" ]
  },
  "Notifications": {
    "IncludePhoneNumberInMail": false
  },
  "DirectorySync": {
    "MinimumExpectedCount": 0,
    "MaxDropFraction": 0.2,
    "StaleAfter": "1.00:00:00"
  },
  "ActiveDirectory": {
    "SearchRoot": "LDAP://<DC-OR-DOMAIN>/OU=<USERS-OU>,DC=<DOMAIN>,DC=<TLD>",
    "SiteAttribute": "<AD-SITE-ATTRIBUTE>"
  },
  "Ops": {
    "WorkerHeartbeatInterval": "00:01:00",
    "WorkerStaleAfterIntervals": 3,
    "OutboxPendingMaxAge": "00:30:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
