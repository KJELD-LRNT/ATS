<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for AssetTracker.Web (ASP.NET Core in-process hosting, Windows Authentication plus anonymous
  access for the super admin sign-in page; the application enforces sign-in everywhere else).
  build/publish.ps1 copies this file over the SDK-generated web.config in the web publish folder.

  Prerequisites (see docs/runbook.md):
  - .NET 10 Hosting Bundle (installs the ASP.NET Core Module V2).
  - IIS role service "Windows Authentication" installed.
  - The authentication sections are locked at server level by default. Unlock them once per server (elevated):
      %windir%\system32\inetsrv\appcmd.exe unlock config -section:system.webServer/security/authentication/windowsAuthentication
      %windir%\system32\inetsrv\appcmd.exe unlock config -section:system.webServer/security/authentication/anonymousAuthentication
  - App pool: "No Managed Code", identity = the gMSA (placeholder DOMAIN\gmsa-ats$).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Framework-dependent deployment: the Hosting Bundle provides the runtime. -->
      <aspNetCore processPath="dotnet" arguments=".\AssetTracker.Web.dll" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <authentication>
          <!--
            Windows sign-in (Kerberos preferred; see the SPN section of the runbook) AND anonymous access, for the whole
            site. Anonymous must be on site-wide for the super admin page /superadmin: with a location rule for that path
            only, IIS would still answer every other page with a 401 and a browser without a domain account would show a
            credentials prompt. The application still requires sign-in on every page except /superadmin and /health*
            (its fallback authorization policy); its 401 makes IIS send the Windows (Negotiate/NTLM) challenge.
            Manual IIS smoke test before go-live: docs/runbook.md, "Super admin".
          -->
          <windowsAuthentication enabled="true">
            <providers>
              <clear />
              <add value="Negotiate" />
              <add value="NTLM" />
            </providers>
          </windowsAuthentication>
          <anonymousAuthentication enabled="true" />
        </authentication>
        <requestFiltering removeServerHeader="true">
          <!-- Upload size is irrelevant to this app (no attachments); keep requests small. -->
          <requestLimits maxAllowedContentLength="1048576" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!--
    Health endpoints for the client's monitoring (/health liveness, /health/ready readiness) are anonymous in the
    application; the site-wide anonymous setting above lets IIS pass them through. They return only status words.
  -->
</configuration>
