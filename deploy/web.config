<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for AssetTracker.Web (ASP.NET Core in-process hosting, Windows Authentication).
  build/publish.ps1 copies this file over the SDK-generated web.config in the web publish folder.

  Prerequisites (see docs/runbook.md):
  - .NET 10 Hosting Bundle (installs the ASP.NET Core Module V2).
  - IIS role service "Windows Authentication" installed.
  - The authentication sections are locked at server level by default. Unlock them once per server (elevated):
      %windir%\system32\inetsrv\appcmd.exe unlock config -section:system.webServer/security/authentication/windowsAuthentication
      %windir%\system32\inetsrv\appcmd.exe unlock config -section:system.webServer/security/authentication/anonymousAuthentication
  - App pool: "No Managed Code", identity = the gMSA (placeholder DOMAIN\gmsa-ats$).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Framework-dependent deployment: the Hosting Bundle provides the runtime. -->
      <aspNetCore processPath="dotnet" arguments=".\AssetTracker.Web.dll" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <authentication>
          <!-- Every page requires integrated Windows sign-in (Kerberos preferred; see the SPN section of the runbook). -->
          <windowsAuthentication enabled="true">
            <providers>
              <clear />
              <add value="Negotiate" />
              <add value="NTLM" />
            </providers>
          </windowsAuthentication>
          <anonymousAuthentication enabled="false" />
        </authentication>
        <requestFiltering removeServerHeader="true">
          <!-- Upload size is irrelevant to this app (no attachments); keep requests small. -->
          <requestLimits maxAllowedContentLength="1048576" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!--
    Health endpoints for the client's monitoring: anonymous allowed (Windows auth stays enabled).
    /health = liveness, /health/ready = readiness (a child path of "health", so this location covers both).
    The application returns only status words for these endpoints: no personal data or internals.
  -->
  <location path="health" inheritInChildApplications="false">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="true" />
          <windowsAuthentication enabled="true" />
        </authentication>
      </security>
    </system.webServer>
  </location>
</configuration>
