{
  "ConnectionStrings": {
    "AssetTracker": "Server=<SQL-HOST>\\SQLEXPRESS;Database=AssetTracker;Integrated Security=True;Encrypt=True"
  },
  "DataProtection": {
    "KeyPath": "<DATA-PROTECTION-KEY-FOLDER>"
  },
  "Settings": {
    "ReloadInterval": "00:00:30"
  },
  "Worker": {
    "HeartbeatInterval": "00:01:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
