<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins the package source for this repository so a build works on a machine whose
  user-level NuGet config has no source (or has nuget.org disabled), e.g. a fresh
  .NET SDK install. All dependencies are public packages from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
